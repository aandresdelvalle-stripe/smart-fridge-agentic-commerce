# The demo is safe by default: no Stripe API calls are made while DEMO_MODE=true.
DEMO_MODE=true

# GreenMart seller network profile (create on the marketplace Stripe account).
# GreenMart and the marketplace are the same business — set this once. Both the agent
# (issues SPTs scoped to this seller) and the marketplace (validates/charges them) read it.
GREENMART_SELLER_NETWORK_PROFILE=

# ── Agent (household wallet / SPT issuance) ──────────────────────────────────
AGENT_PORT=4243
# How the agent reaches GreenMart checkout:
#   local  — HTTP to the simulated ACS /acp surface (default; no Stripe ACS access needed)
#   stripe — Stripe Delegated Checkout API (RequestedSession); requires ACS access on your accounts
ACS_MODE=local
AGENT_STRIPE_SECRET_KEY=
AGENT_STRIPE_PUBLISHABLE_KEY=
AGENT_STRIPE_API_VERSION=2026-04-22.preview
# Payment method tokenized in the household wallet during an earlier session (pm_...).
HOUSEHOLD_PAYMENT_METHOD=

# ── Marketplace (GreenMart seller via Agentic Commerce Suite) ───────────────
MARKETPLACE_PORT=4242
MARKETPLACE_URL=http://localhost:4242
MARKETPLACE_STRIPE_SECRET_KEY=
MARKETPLACE_STRIPE_WEBHOOK_SECRET=
MARKETPLACE_STRIPE_API_VERSION=2026-04-22.preview

# Legacy fallbacks (optional; prefer the split keys above):
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_VERSION=2026-04-22.preview
# MARKETPLACE_SELLER_NETWORK_PROFILE=   # deprecated alias for GREENMART_SELLER_NETWORK_PROFILE
# STRIPE_SELLER_NETWORK_PROFILE=        # deprecated alias for GREENMART_SELLER_NETWORK_PROFILE
